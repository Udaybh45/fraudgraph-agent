# FraudGraph Agent Environment Variables
# TigerGraph Savanna / Community Configuration
TIGERGRAPH_HOST=http://127.0.0.1:9000
TIGERGRAPH_GRAPH_NAME=FraudGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_SECRET=
TIGERGRAPH_REST_PORT=9000
TIGERGRAPH_GS_PORT=14240
# Set to 'false' if connecting to live TigerGraph Savanna cloud instance
USE_TIGERGRAPH_EMULATOR=true

# LLM Reasoning Settings (Optional: Uses intelligent deterministic reasoning when omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Risk & Decision Thresholds
UNCERTAINTY_THRESHOLD_HIGH=0.40
CONFIDENCE_THRESHOLD_ACT=0.70
CRITICAL_RISK_THRESHOLD=0.80
HIGH_VALUE_THRESHOLD=2000.0

# Server Settings
PORT=8000
HOST=0.0.0.0
